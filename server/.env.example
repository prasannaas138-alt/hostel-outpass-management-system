PORT=5000
MONGO_URI=mongodb://localhost:27017/hostel_outpass
MONGODB_URI=mongodb://localhost:27017/hostel_outpass

JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Demo account credentials (backend-only, never committed to source).
# The seed script fails fast if any of these are missing.
DEMO_STUDENT_PASSWORD=change_me
DEMO_HOD_PASSWORD=change_me
DEMO_SISTER_PASSWORD=change_me
DEMO_WARDEN_PASSWORD=change_me

# --- Development/testing environment separation -------------------------------
# Local runs must point MONGO_URI at the HOMS_DEVELOPMENT database (append
# /HOMS_DEVELOPMENT after the cluster host). Production (Render) keeps its own
# separate MONGO_URI pointing at the production database — never copy one to
# the other, and never commit real credentials. Pattern (placeholder only):
#   MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/HOMS_DEVELOPMENT?retryWrites=true&w=majority

# Demo Student 1/2/3 passwords — used ONLY by `npm run seed:dev`
# (server/scripts/seedDevDemoStudents.js). That script is never run on server
# startup, so these accounts are created only when you run it manually.
DEMO_STUDENT1_PASSWORD=change_me
DEMO_STUDENT2_PASSWORD=change_me
DEMO_STUDENT3_PASSWORD=change_me